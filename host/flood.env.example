# nethersec flood / DDoS detector: tuning (flood-report.sh).
# install.sh --with-flood writes /etc/nethersec/flood.env (root:root, mode 600) from
# this file and never overwrites an existing one. The report transport and the box
# name (HOSTSEC_SOURCE) come from /etc/nethersec/report.env; this file holds ONLY the
# flood knobs.
#
# Thresholds ship HIGH so a busy box never cries wolf. BASELINE each box first (watch a
# normal day), then ratchet down. Keep your tuned values private: they tell an attacker
# how far under the radar to stay.

# Optional: a distinct source name / group for flood cards (defaults to HOSTSEC_SOURCE
# / HOSTSEC_GROUP from report.env).
#HOSTSEC_FLOOD_SOURCE=
#HOSTSEC_FLOOD_GROUP=

# Re-assert a still-raised flood card at most this often (seconds). Default 1h.
#HOSTSEC_FLOOD_RESURFACE_SECS=3600
# Per-run post cap (overflow logged, never dropped). Default 6.
#HOSTSEC_FLOOD_MAX_POSTS=6

# --- check 1: connection flood (conntrack / SYN-recv / dominant established) ---
# conntrack count/max percentage that raises a card (0 disables). Default 85.
#HOSTSEC_FLOOD_CONNTRACK_PCT=85
# SYN-recv half-open sockets that raise (a SYN flood). 0 disables. Default 500.
#HOSTSEC_FLOOD_SYNRECV=500
# Established connections before the dominant-source check runs. 0 disables. Default 3000.
#HOSTSEC_FLOOD_ESTAB_MIN=3000
# Top-source share (%) of established conns that raises. Default 60.
#HOSTSEC_FLOOD_ESTAB_SHARE_PCT=60
# Severity: critical (page) | warning (quiet, DEFAULT) | info.
#HOSTSEC_FLOOD_CONN_SEVERITY=warning

# --- check 2: inbound network volume (PPS / BPS from /proc/net/dev) ------------
# Inbound packets/sec that raises (0 disables). Default 120000.
#HOSTSEC_FLOOD_PPS=120000
# Inbound megabits/sec that raises (0 disables). Default 800.
#HOSTSEC_FLOOD_MBPS=800
# Interface to watch (default: the default-route interface, else eth0).
#HOSTSEC_FLOOD_NET_IFACE=
#HOSTSEC_FLOOD_NET_SEVERITY=warning

# --- check 3: HTTP request flood (Caddy JSON access log) -----------------------
# Requires the box's Caddy to log `format json` (a `log { format json }` block) to
# stdout, so `docker logs` sees it. Inert on a box with no Caddy container.
#HOSTSEC_FLOOD_HTTP_ENABLE=1
# Caddy container name (default: auto-detect a container whose name contains "caddy").
#HOSTSEC_FLOOD_HTTP_CONTAINER=
# Requests in the window before the check raises anything (0 disables). Default 6000.
#HOSTSEC_FLOOD_HTTP_MIN=6000
# Top-client share (%) that raises and names that client, who can then be blocked.
# A client in the CDN ranges, or whose requests mostly claim a good-bot User-Agent,
# is named but never blocked. Default 55.
#HOSTSEC_FLOOD_HTTP_SHARE_PCT=55
# Requests a minute from all clients together that raise when no single client holds
# the share above (a flood from many addresses, or a real rush of users). It never
# blocks. Default 18000; 0 disables.
#HOSTSEC_FLOOD_HTTP_TOTAL_PER_MIN=18000
#HOSTSEC_FLOOD_HTTP_SEVERITY=warning

# --- check 4: SMTP connect burst (mailserver container logs) -------------------
# Inert on a box with no mailserver container.
#HOSTSEC_FLOOD_SMTP_ENABLE=1
# Mailserver container name (default: auto-detect a container whose name contains "mail").
#HOSTSEC_FLOOD_SMTP_CONTAINER=
# `connect from` events in the window that raise (0 disables). Default 1500.
#HOSTSEC_FLOOD_SMTP_MIN=1500
# The card names the top source when it holds at least this share (%) of the connects.
# It does not raise the card (the count above does), and this check never blocks.
# Default 60.
#HOSTSEC_FLOOD_SMTP_SHARE_PCT=60
#HOSTSEC_FLOOD_SMTP_SEVERITY=warning

# --- mitigation (ships DARK; dry-run by default) -----------------------------
# 0 (DEFAULT) = detect + alert only; a confirmed dominant attacker IP is LOGGED as a
# would-drop but nothing is blocked. 1 = arm the real self-expiring nftables drop.
# Only the exact value 1 arms it; any other value (true, yes, a typo) is 0 and logged.
# Turn on per box ONLY after watching the detector fire correctly (fire-drill style).
# NEVER arm on a docker-mailserver box (it runs its own in-container fail2ban/
# nftables; a host rule would collide).
#HOSTSEC_FLOOD_MITIGATE=0
# Self-expiry of an auto-drop, minutes. Default 60.
#HOSTSEC_FLOOD_MITIGATE_MINUTES=60
# Cap on auto-drops per hour (excess falls through to a human alert). Default 6.
#HOSTSEC_FLOOD_MITIGATE_MAX_PER_HOUR=6
# IPs to NEVER drop, comma/space separated: your own app's egress (e.g. the servers
# that talk to a database on this box), uptime monitors, your admin IP. The
# Cloudflare/Fastly CDN ranges + good-bot UAs are ALWAYS spared automatically.
#HOSTSEC_FLOOD_ALLOW_IPS=
