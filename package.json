{
  "name": "discord-cve-monitor",
  "version": "1.0.0",
  "description": "Self-hosted Discord bot that watches your GitHub repos' lockfiles for known vulnerabilities and posts alerts in channels it sets up.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
