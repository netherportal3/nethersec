# Copy this file to .env and fill it in. Never commit .env.

# Your bot's token, from the Discord Developer Portal (Bot > Reset Token).
DISCORD_TOKEN=

# The ID of the one server the bot serves. Turn on Developer Mode in Discord
# (Settings > Advanced), then right-click the server icon > Copy Server ID.
# The bot leaves any other server it is added to.
DISCORD_GUILD_ID=

# Optional. A GitHub token that can read your repos, for repo scanning.
# Without it, repo scanning is off. See "Create a GitHub token" in docs/hub/README.md.
# GITHUB_TOKEN=

# Optional. Where the report server listens (default 127.0.0.1:8787).
# The Docker image and docker-compose.yml set 0.0.0.0:8787 inside the container.
# NETHERSEC_LISTEN=127.0.0.1:8787

# Optional. Turns on GET /v1/state (for scripts and the MCP server). At least
# 24 characters. Make one with: openssl rand -hex 32
# NETHERSEC_API_TOKEN=

# Optional. The URL your servers and PCs use to reach the hub, shown in setup
# hints and on the status board. Like https://hub.example.com
# NETHERSEC_PUBLIC_URL=

# Optional. Minutes between repo scans for a new install (15 to 1440, default 60).
# After setup, change it with /nethersec settings instead.
# SCAN_INTERVAL_MINUTES=60

# Optional. Where the hub keeps its state and keys.txt (default ./data).
# DATA_DIR=./data
