# Copy this file to .env and fill it in. Never commit .env.

# Your bot's token, from the Discord Developer Portal (Bot > Reset Token).
DISCORD_TOKEN=

# The ID of the one server the bot serves. Turn on Developer Mode in Discord
# (Settings > Advanced), then right-click the server icon > Copy Server ID.
# The bot leaves any other server it is added to.
DISCORD_GUILD_ID=

# A GitHub token that can read your repos. See "GitHub token" in the README.
GITHUB_TOKEN=

# Optional. Minutes between scans for a new install (15 to 1440, default 60).
# After setup, change it with /cve settings instead.
# SCAN_INTERVAL_MINUTES=60

# Optional. Where the bot keeps its state (default ./data).
# DATA_DIR=./data
